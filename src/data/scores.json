        "label": "Pression systolique à la cheville (mmHg)",
        "type": "number",
        "unite": "mmHg"
      }
    ],
    "calcul": "IPS = Pression cheville / Pression bras",
    "interpretation": "IPS > 0.9: Normal; 0.7-0.9: Claudication probable; 0.4-0.7: Ischémie modérée; < 0.4: Ischémie critique"
  },
